21-07-03T12:36:54.000Z&#34;,&#34;location&#34;:null,&#34;src&#34;:&#34;https://pub-0746d4ae7a974887862f7a47195bb7d7.r2.dev/DSC_0706.jpg&#34;,&#34;title&#34;:&#34;DSC_0706.jpg&#34;}];&#xA;    const galleryItems = rawData.map(item =&gt; ({&#xA;      src: item.src,&#xA;      srct: &#39;https://wsrv.nl/?url=&#39; + item.src.replace(&#39;https://&#39;, &#39;&#39;) + &#39;&amp;w=500&amp;output=webp&amp;q=80&#39;,&#xA;      title: item.location ? &#39;📍 &#39; + item.location : item.title,&#xA;      customData: { &#xA;        date: new Date(item.date).getTime(),&#xA;        location: item.location&#xA;      }&#xA;    }));&#xA;&#xA;    const galleryConfig = {&#xA;      galleryDisplayMode: &#34;justified&#34;,&#xA;      thumbnailHeight: &#34;250 XS150 SM200&#34;,&#xA;      thumbnailWidth: &#34;auto&#34;,&#xA;      thumbnailGutterWidth: 5,&#xA;      thumbnailGutterHeight: 5,&#xA;      thumbnailBorderHorizontal: 0,&#xA;      thumbnailBorderVertical: 0,&#xA;      thumbnailDisplayTransition: &#34;slideUp&#34;,&#xA;      thumbnailHoverEffect2: &#34;imageScale150&#34;,&#xA;      thumbnailAlignment: &#34;center&#34;,&#xA;      viewerOnClick: &#34;next&#34;,&#xA;      thumbnailLabel: { display: false },&#xA;      colorScheme: {&#xA;        thumbnail: {&#xA;          background: &#34;rgba(0,0,0,0)&#34;&#xA;        }&#xA;      }&#xA;    };&#xA;&#xA;    function initGallery(items) {&#xA;      const $oldGallery = $(&#39;#nanogallery2&#39;);&#xA;      &#xA;      &#xA;      if ($oldGallery.length) {&#xA;        try { $oldGallery.nanogallery2(&#39;destroy&#39;); } catch(e) {}&#xA;        $oldGallery.remove();&#xA;      }&#xA;      &#xA;      $(&#39;&lt;div id=&#34;nanogallery2&#34; style=&#34;width: 100%;&#34;&gt;&lt;/div&gt;&#39;).insertAfter(&#39;.gallery-controls&#39;);&#xA;      &#xA;      &#xA;      $(&#39;#nanogallery2&#39;).nanogallery2({&#xA;        ...galleryConfig,&#xA;        items: items&#xA;      });&#xA;    }&#xA;&#xA;    function sortGallery(method) {&#xA;      let sortedItems = [...galleryItems];&#xA;      if (method === &#39;newest&#39;) {&#xA;        sortedItems.sort((a, b) =&gt; b.customData.date - a.customData.date);&#xA;      } else if (method === &#39;oldest&#39;) {&#xA;        sortedItems.sort((a, b) =&gt; a.customData.date - b.customData.date);&#xA;      } else if (method === &#39;location&#39;) {&#xA;        sortedItems.sort((a, b) =&gt; {&#xA;          const locA = a.customData.location || &#39;ZZZ&#39;;&#xA;          const locB = b.customData.location || &#39;ZZZ&#39;;&#xA;          return locA.localeCompare(locB);&#xA;        });&#xA;      } else if (method === &#39;random&#39;) {&#xA;        sortedItems.sort(() =&gt; Math.random() - 0.5);&#xA;      }&#xA;      initGallery(sortedItems);&#xA;    }&#xA;&#xA;    &#xA;    $(document).ready(function() {&#xA;      sortGallery(&#39;random&#39;);&#xA;    });&#xA;  &lt;/script&gt;</description>
			</item>
			<item>
				<title>How to Get the Best Views at Circuit Gilles Villeneuve with a General Admission Ticket</title>
				<link>https://www.manas96.github.io/blog/f1guide/</link>
				<pubDate>Sun, 02 Apr 2023 12:30:00 +0600</pubDate>
				<guid>https://www.manas96.github.io/blog/f1guide/</guid>
				<description>&lt;p&gt;As a fan of F1 from the Schumacher era, I&amp;rsquo;ve always wanted to attend a race. So I was beyond excited when I found out I live &lt;a href=&#34;https://goo.gl/maps/qRpgzHaGhgm3MvVVA&#34;&gt;&lt;strong&gt;just 20 min away&lt;/strong&gt;&lt;/a&gt; from an active F1 track. Since F1 is an expensive sport and I am a student, I decided to attend only on race day (Sunday) and make the most out of my ticket. In December 2021, I bought the cheapest General Admission ticket (&lt;strong&gt;$130 CAD&lt;/strong&gt;) for the Canadian Grand Prix scheduled in June 2022.&lt;/p&gt;</description>
			</item>
